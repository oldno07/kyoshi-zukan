---
// 図鑑 追尾フッター用アイコン（6種）
// 線幅1.25px / 24格子 / 色は currentColor 追従（CSS側で制御）
interface Props {
  name: 'ledger' | 'catalog' | 'world' | 'transfer' | 'prev' | 'next';
}
const { name } = Astro.props;

const PATHS: Record<string, string> = {
  // 図鑑トップ：開いた台帳の見開き＋中央に◈の芯
  ledger: `<path d="M3 5.5h6.2c1.1 0 2 .9 2 2V19c0-1-.9-1.8-2-1.8H3z"/><path d="M21 5.5h-6.2c-1.1 0-2 .9-2 2V19c0-1 .9-1.8 2-1.8H21z"/><path d="M12 9.4l1.1 1.4L12 12.2l-1.1-1.4z"/>`,
  // 標本目録：4分割の格子＝カード一覧
  catalog: `<rect x="3.5" y="3.5" width="7" height="7"/><rect x="13.5" y="3.5" width="7" height="7"/><rect x="3.5" y="13.5" width="7" height="7"/><rect x="13.5" y="13.5" width="7" height="7"/>`,
  // 世界観：観測範囲を示す同心の弧＋緯線
  world: `<circle cx="12" cy="12" r="8.5"/><path d="M12 3.5c2.6 2.4 4 5.3 4 8.5s-1.4 6.1-4 8.5c-2.6-2.4-4-5.3-4-8.5s1.4-6.1 4-8.5z"/><path d="M3.9 9.2h16.2M3.9 14.8h16.2"/>`,
  // 入手する：外部への移送（箱＋↗）
  transfer: `<path d="M13.5 4.5H5.2c-.9 0-1.7.8-1.7 1.7v12.1c0 .9.8 1.7 1.7 1.7h12.1c.9 0 1.7-.8 1.7-1.7v-8.3"/><path d="M14.2 9.8L20.5 3.5"/><path d="M15.6 3.5h4.9v4.9"/>`,
  // 前の個体：左向き山括弧＋個体を示す点
  prev: `<path d="M13.8 5.8L7.6 12l6.2 6.2"/><circle cx="17.4" cy="12" r="1.15" fill="currentColor" stroke="none"/>`,
  // 次の個体：右向き山括弧＋点
  next: `<path d="M10.2 5.8L16.4 12l-6.2 6.2"/><circle cx="6.6" cy="12" r="1.15" fill="currentColor" stroke="none"/>`,
};

const inner = PATHS[name] ?? PATHS.ledger;
---

<svg
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.25"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={inner}
></svg>
