---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FooterIcon from '../../components/FooterIcon.astro';

export async function getStaticPaths() {
  // hidden も含めて全件取得（欠番演出ページを生成するため）
  const all = await getCollection('creatures');
  // creature を no 順に並べ、symbiont は全 creature の後ろにまとめる
  const sorted = all.sort((a, b) => {
    if (a.data.category !== b.data.category) {
      return a.data.category === 'symbiont' ? 1 : -1;
    }
    return a.data.no.localeCompare(b.data.no);
  });

  function toSlug(id: string) {
    return id.replace(/\/index\.md$/, '').replace(/\.md$/, '');
  }

  return sorted.map((entry, index) => {
    const slug = toSlug(entry.id);
    const prevEntry = index > 0 ? sorted[index - 1] : null;
    const nextEntry = index < sorted.length - 1 ? sorted[index + 1] : null;

    const relatedCreatures = (entry.data.related ?? [])
      .map(relSlug => sorted.find(e => toSlug(e.id) === relSlug))
      .filter(Boolean)
      .map(rc => ({
        slug: toSlug(rc.id),
        no: rc.data.no,
        name_jp: rc.data.name_jp,
        name_en: rc.data.name_en,
        rarity: rc.data.rarity,
        tag: rc.data.tag,
        cover: rc.data.cover,
      }));

    return {
      params: { slug },
      props: {
        entry,
        prev: prevEntry
          ? {
              slug: toSlug(prevEntry.id),
              name_jp: prevEntry.data.status === 'hidden' ? 'UNKNOWN ENTITY' : prevEntry.data.name_jp,
              name_en: prevEntry.data.status === 'hidden' ? '██████' : prevEntry.data.name_en,
            }
          : null,
        next: nextEntry
          ? {
              slug: toSlug(nextEntry.id),
              name_jp: nextEntry.data.status === 'hidden' ? 'UNKNOWN ENTITY' : nextEntry.data.name_jp,
              name_en: nextEntry.data.status === 'hidden' ? '██████' : nextEntry.data.name_en,
            }
          : null,
        relatedCreatures,
      },
    };
  });
}

const { entry, prev, next, relatedCreatures } = Astro.props;
const { slug } = Astro.params;
const { data } = entry;
const isHidden = data.status === 'hidden';
const { Content } = await render(entry);

const ogTitle = isHidden
  ? `No.${data.no} UNKNOWN ENTITY | 鋸歯生物図鑑`
  : `${data.name_jp} / ${data.name_en} | 鋸歯生物図鑑`;
const ogDescription = isHidden
  ? `No.${data.no} — 観測記録はアクセス制限されています。`
  : data.notes
    ? data.notes.slice(0, 100) + (data.notes.length > 100 ? '…' : '')
    : `No.${data.no} ${data.name_jp} — 鋸歯生物観測記録`;
---

<BaseLayout
  title={ogTitle}
  description={ogDescription}
  ogImage={isHidden ? '/images/ogp.png' : data.cover}
  ogUrl={`https://pelicanworks.site/zukan/${slug}/`}
>
  <!-- breadcrumb strip -->
  <nav class="cd-strip">
    <a href="/zukan/" class="cd-strip-back">← FIELD DATABASE</a>
    <div class="cd-strip-path">
      <span>CREATURES</span>
      <span class="cd-strip-sep">/</span>
      <span class="cd-strip-id">No.{data.no}</span>
    </div>
  </nav>

  <!-- hero -->
  <section class="cd-hero">
    <div class="cd-hero-l">
      <div class="cd-hero-meta">
        <span class="cd-no">No.{data.no}</span>
        {isHidden
          ? <span class="cd-rarity cd-rarity--inline" style="background:var(--red);color:#fff;border-color:var(--red);">ACCESS DENIED</span>
          : <span class={`cd-rarity cd-rarity--inline ${data.rarity}`}>{data.rarity}</span>
        }
        {!isHidden && <span class="cd-tag cd-tag--inline">{data.tag}</span>}
      </div>
      <h1 class="cd-name-jp" style={isHidden ? 'color:var(--red);letter-spacing:0.1em;' : ''}>
        {isHidden ? 'UNKNOWN ENTITY' : data.name_jp}
      </h1>
      <!-- モバイルでは英語名と種族タグを同じ行・右寄せに配置する（cd-name-en-rowは
           デスクトップでは素通しのラッパーで見た目に影響しない） -->
      <div class="cd-name-en-row">
        <p class="cd-name-en" style={isHidden ? 'color:var(--ink3);' : ''}>
          {isHidden ? '██████' : data.name_en}
        </p>
        {!isHidden && <span class="cd-tag cd-tag--beside">{data.tag}</span>}
      </div>

      {!isHidden && data.status_label && (
        <span class="cd-status-badge cd-status-badge--inline" style={`color: ${data.status_color ?? 'var(--g)'}`}>
          ● {data.status_label}
        </span>
      )}
      {isHidden && (
        <span class="cd-status-badge cd-status-badge--inline" style="color:var(--red);">
          ● ACCESS RESTRICTED
        </span>
      )}
    </div>

    <div class="cd-hero-r">
      {isHidden
        ? <div class="cd-no-visual" style="background:#111;color:#333;font-size:32px;letter-spacing:0.05em;">██</div>
        : data.cover
          ? <img src={data.cover} alt={data.name_jp} class="cd-cover" loading="eager" />
          : <div class="cd-no-visual">NO VISUAL DATA</div>
      }
      <!-- モバイルではレア度バッジも名前エリアではなく写真のグレーエリア右上に重ねて表示する -->
      {isHidden
        ? <span class="cd-rarity cd-rarity--overlay cd-rarity--denied">ACCESS DENIED</span>
        : <span class={`cd-rarity cd-rarity--overlay ${data.rarity}`}>{data.rarity}</span>
      }
      <!-- モバイルではSTATUSバッジを名前エリアではなく写真のグレーエリアに重ねて表示し、名前エリアをよりコンパクトにする -->
      {!isHidden && data.status_label && (
        <span class="cd-status-badge cd-status-badge--overlay" style={`color: ${data.status_color ?? 'var(--g)'}`}>
          ● {data.status_label}
        </span>
      )}
      {isHidden && (
        <span class="cd-status-badge cd-status-badge--overlay" style="color:var(--red);">
          ● ACCESS RESTRICTED
        </span>
      )}
    </div>
  </section>

  <!-- status bars -->
  <section class="cd-status">
    <p class="cd-status-title">BIOLOGICAL STATUS</p>
    <div class="cd-bars">
      <div class="cd-bar-row">
        <span class="cd-bar-label">PLANT</span>
        <div class="cd-bar-track">
          {!isHidden && <div class="cd-bar-fill plant" style={`width: ${data.plant}%`}></div>}
        </div>
        <span class="cd-bar-val">{isHidden ? '—' : data.plant}</span>
      </div>
      <div class="cd-bar-row">
        <span class="cd-bar-label">ANIMAL</span>
        <div class="cd-bar-track">
          {!isHidden && <div class="cd-bar-fill animal" style={`width: ${data.animal}%`}></div>}
        </div>
        <span class="cd-bar-val">{isHidden ? '—' : data.animal}</span>
      </div>
      <div class="cd-bar-row">
        <span class="cd-bar-label">DANGER</span>
        <div class="cd-bar-track">
          {!isHidden && <div class="cd-bar-fill danger" style={`width: ${data.danger}%`}></div>}
        </div>
        <span class="cd-bar-val">{isHidden ? '—' : data.danger}</span>
      </div>
    </div>
  </section>

  <!-- mobile transfer teaser: compact EC entry point, shown only on narrow screens -->
  {!isHidden && data.shopUrl && !data.soldOut && (
    <a href={data.shopUrl} class="cd-transfer-mini" target="_blank" rel="noopener">
      <div class="cd-transfer-mini-row">
        <span class="cd-transfer-mini-tag">TRANSFER / 譲渡</span>
        <span class="cd-transfer-mini-price">
          {data.price ? `¥${data.price.toLocaleString()}` : '譲渡局で開示'}
        </span>
      </div>
      <span class="cd-transfer-mini-cta">この個体を迎え入れる →</span>
    </a>
  )}
  {!isHidden && data.soldOut && data.shopUrl && (
    <a href={data.shopUrl} class="cd-transfer-mini cd-transfer-mini-soldout" target="_blank" rel="noopener">
      <div class="cd-transfer-mini-row">
        <span class="cd-transfer-mini-tag">SPECIMEN / 標本</span>
        <span class="cd-transfer-mini-price">SOLD OUT</span>
      </div>
      <span class="cd-transfer-mini-cta">ほかの個体を見る →</span>
    </a>
  )}
  {!isHidden && data.soldOut && !data.shopUrl && (
    <div class="cd-transfer-mini cd-transfer-mini-soldout">
      <div class="cd-transfer-mini-row">
        <span class="cd-transfer-mini-tag">SPECIMEN / 標本</span>
        <span class="cd-transfer-mini-price">SOLD OUT</span>
      </div>
    </div>
  )}

  <!-- body -->
  <article class="cd-body">

    {isHidden
      ? (
        <div class="cd-body-text cd-redacted-notice">
          <p>[ RECORD CLASSIFIED — ACCESS DENIED ]</p>
          <p>この個体の観測記録は現在非公開です。</p>
        </div>
      )
      : (
        <div class="cd-body-text">
          <Content />
        </div>
      )
    }

    {!isHidden && data.notes && (
      <div class="cd-note">
        <p class="cd-note-label">
          RESEARCH NOTE{data.namer ? ` — ${data.namer}` : ''}
        </p>
        <p class="cd-note-text">{data.notes}</p>
      </div>
    )}

    {!isHidden && data.abilities.length > 0 && (
      <div style="margin-bottom: 32px;">
        <p class="cd-status-title" style="margin-bottom: 12px;">ABILITIES</p>
        <div class="cd-abilities">
          {data.abilities.map((a) => (
            <span class="cd-ability">{a}</span>
          ))}
        </div>
      </div>
    )}

    <!-- フィールドデータ -->
    <div class="cd-data">
      <div class="cd-data-row">
        <span class="cd-data-key">HABITAT</span>
        <span class="cd-data-val">{isHidden ? '██████' : data.habitat}</span>
      </div>
      <div class="cd-data-row">
        <span class="cd-data-key">SIZE</span>
        <span class="cd-data-val">{isHidden ? '██████' : data.size}</span>
      </div>
      <div class="cd-data-row">
        <span class="cd-data-key">MOBILITY</span>
        <span class="cd-data-val">{isHidden ? '██████' : data.mobility}</span>
      </div>
      {!isHidden && data.top && (
        <div class="cd-data-row">
          <span class="cd-data-key">BASED ON</span>
          <span class="cd-data-val">{data.top}</span>
        </div>
      )}
    </div>

    {!isHidden && data.shopUrl && !data.soldOut && (
      <a href={data.shopUrl} class="cd-shop-panel" target="_blank" rel="noopener">
        <div class="cd-shop-panel-title">
          <span>TRANSFER FILE / 譲渡可能個体</span>
          <span>→</span>
        </div>
        <div class="cd-shop-panel-price">
          {data.price ? `¥${data.price.toLocaleString()}` : '入手条件：譲渡局で開示'}
        </div>
        <p class="cd-shop-panel-sub">STORESにて譲渡申請を受付</p>
        <span class="cd-shop-panel-btn">この個体を迎え入れる →</span>
      </a>
    )}
    {!isHidden && data.soldOut && data.shopUrl && (
      <a href={data.shopUrl} class="cd-shop-soldout" target="_blank" rel="noopener">
        <div class="cd-shop-soldout-title">SPECIMEN / 標本</div>
        <div class="cd-shop-soldout-price">SOLD OUT</div>
        <p class="cd-shop-soldout-sub">この個体の販売は終了しました。ほかの個体はこちら →</p>
      </a>
    )}
    {!isHidden && data.soldOut && !data.shopUrl && (
      <div class="cd-shop-soldout">
        <div class="cd-shop-soldout-title">SPECIMEN / 標本</div>
        <div class="cd-shop-soldout-price">SOLD OUT</div>
        <p class="cd-shop-soldout-sub">この個体の販売は終了しました</p>
      </div>
    )}

  </article>

  <!-- gallery -->
  {!isHidden && data.gallery.length > 0 && data.gallery.some(g => g.path) && (
    <section class="cd-gallery">
      <p class="cd-gallery-title">OBSERVATION GALLERY</p>
      <div class="cd-gallery-grid">
        {data.gallery.filter(g => g.path).map((g) => (
          <div class="cd-gallery-item">
            <img src={g.path} alt={g.title ?? ''} loading="lazy" />
            {(g.title || g.desc) && (
              <div class="cd-gallery-cap">
                {g.title && <p class="cd-gallery-cap-title">{g.title}</p>}
                {g.desc  && <p class="cd-gallery-cap-desc">{g.desc}</p>}
              </div>
            )}
          </div>
        ))}
      </div>
    </section>
  )}

  <!-- videos -->
  {!isHidden && data.videos.length > 0 && (
    <section class="cd-videos">
      <p class="cd-videos-title">OBSERVATION RECORDS</p>
      <div class="cd-video-list">
        {data.videos.map((v) => (
          <div>
            {v.title && <p class="cd-video-label">{v.observedAt ? `[${v.observedAt}] ` : ''}{v.title}</p>}
            <div class="cd-video-embed">
              <iframe
                src={`https://www.youtube.com/embed/${v.youtubeId}`}
                title={v.title ?? '観測動画'}
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen
                loading="lazy"
              ></iframe>
            </div>
          </div>
        ))}
      </div>
    </section>
  )}

  <!-- ===== PREV / NEXT NAV ===== -->
  <nav class="cd-prevnext">
    {prev
      ? (
        <a href={`/zukan/${prev.slug}/`} class="cd-prevnext-btn">
          <span class="cd-prevnext-dir">← PREV</span>
          <span class="cd-prevnext-jp">{prev.name_jp}</span>
          <span class="cd-prevnext-en">{prev.name_en}</span>
        </a>
      )
      : <span class="cd-prevnext-btn cd-prevnext-empty">— FIRST ENTRY —</span>
    }
    {next
      ? (
        <a href={`/zukan/${next.slug}/`} class="cd-prevnext-btn cd-prevnext-right">
          <span class="cd-prevnext-dir">NEXT →</span>
          <span class="cd-prevnext-jp">{next.name_jp}</span>
          <span class="cd-prevnext-en">{next.name_en}</span>
        </a>
      )
      : <span class="cd-prevnext-btn cd-prevnext-right cd-prevnext-empty">— LAST ENTRY —</span>
    }
  </nav>

  <!-- ===== TAXONOMY: TAGS + SERIES ===== -->
  {!isHidden && (data.tags.length > 0 || data.series.length > 0) && (
    <div class="cd-taxonomy">
      {data.series.length > 0 && (
        <div class="cd-tax-row">
          <span class="cd-tax-key">SERIES</span>
          <div class="cd-tax-chips">
            {data.series.map((s) => (
              <span class="cd-chip cd-chip-series">{s}</span>
            ))}
          </div>
        </div>
      )}
      {data.tags.length > 0 && (
        <div class="cd-tax-row">
          <span class="cd-tax-key">TAGS</span>
          <div class="cd-tax-chips">
            {data.tags.map((t) => (
              <span class="cd-chip">{t}</span>
            ))}
          </div>
        </div>
      )}
    </div>
  )}

  <!-- ===== RELATED ENTITIES ===== -->
  {!isHidden && relatedCreatures.length > 0 && (
    <section class="cd-related">
      <p class="cd-related-title">RELATED ENTITIES</p>
      <div class="cd-related-grid">
        {relatedCreatures.map((rc) => (
          <a href={`/zukan/${rc.slug}/`} class="cd-related-card">
            <div class="cd-related-img">
              {rc.cover
                ? <img src={rc.cover} alt={rc.name_jp} loading="lazy" />
                : <div class="cd-related-noimg">NO VISUAL</div>
              }
            </div>
            <div class="cd-related-info">
              <span class="cd-related-no">No.{rc.no}</span>
              <span class={`cd-related-rarity ${rc.rarity}`}>{rc.rarity}</span>
              <p class="cd-related-jp">{rc.name_jp}</p>
              <p class="cd-related-en">{rc.name_en}</p>
            </div>
          </a>
        ))}
      </div>
    </section>
  )}

  <!-- END OF RECORD marker -->
  <div class="cd-sys">
    <div class="cd-sys-line"></div>
    <span class="cd-sys-label">END OF RECORD — No.{data.no}</span>
    <div class="cd-sys-line"></div>
  </div>

  <!-- ===== MOBILE FIXED FOOTER BAR ===== -->
  <div class="mobile-fixed-footer" id="mobile-fixed-footer">
    {prev
      ? (
        <a href={`/zukan/${prev.slug}/`} class="mobile-footer-link">
          <span class="mobile-footer-icon"><FooterIcon name="prev" /></span>
          <span class="mobile-footer-text">前の個体</span>
        </a>
      )
      : <span class="mobile-footer-link mobile-footer-disabled">
          <span class="mobile-footer-icon"><FooterIcon name="prev" /></span>
          <span class="mobile-footer-text">前の個体</span>
        </span>
    }
    <a href="/zukan/" class="mobile-footer-link">
      <span class="mobile-footer-icon"><FooterIcon name="ledger" /></span>
      <span class="mobile-footer-text">図鑑トップ</span>
    </a>
    {next
      ? (
        <a href={`/zukan/${next.slug}/`} class="mobile-footer-link">
          <span class="mobile-footer-icon"><FooterIcon name="next" /></span>
          <span class="mobile-footer-text">次の個体</span>
        </a>
      )
      : <span class="mobile-footer-link mobile-footer-disabled">
          <span class="mobile-footer-icon"><FooterIcon name="next" /></span>
          <span class="mobile-footer-text">次の個体</span>
        </span>
    }
  </div>

  <!-- モバイル固定バーのスクロール制御 -->
  <script>
    const bar = document.getElementById('mobile-fixed-footer');
    if (bar) {
      let lastY = 0;
      window.addEventListener('scroll', () => {
        const y = window.scrollY;
        // 下スクロール時に非表示、上スクロール or トップ付近で表示
        if (y > lastY && y > 80) {
          bar.classList.remove('visible');
        } else {
          bar.classList.add('visible');
        }
        lastY = y;
      }, { passive: true });
      // 初期表示
      bar.classList.add('visible');
    }
  </script>

</BaseLayout>
