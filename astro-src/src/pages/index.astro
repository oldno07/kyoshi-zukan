          <div class="hero-stat-item">
            <div class="hero-stat-label">登録標本数</div>
            <div class="hero-stat-value">{found}</div>
          </div>
        </div>
        <!-- CTA Buttons -->
        <div class="hero-cta-row">
          <a href="#catalog" class="btn btn-p">
            <svg width="11" height="11" viewBox="0 0 11 11" fill="none">
              <rect x="1" y="1" width="3.5" height="3.5" stroke="currentColor" stroke-width="1"/>
              <rect x="6.5" y="1" width="3.5" height="3.5" stroke="currentColor" stroke-width="1"/>
              <rect x="1" y="6.5" width="3.5" height="3.5" stroke="currentColor" stroke-width="1"/>
              <rect x="6.5" y="6.5" width="3.5" height="3.5" stroke="currentColor" stroke-width="1"/>
            </svg>
            標本目録を見る
          </a>
          <a href="https://agavest.stores.jp/?utm_source=zukan&utm_medium=internal&utm_campaign=species_link" target="_blank" class="btn btn-p">
            譲渡局へ
            <svg width="11" height="11" viewBox="0 0 11 11" fill="none">
              <path d="M2 5.5H9M9 5.5L6 2.5M9 5.5L6 8.5" stroke="currentColor" stroke-width="1"/>
            </svg>
          </a>
        </div>
        <!-- Transfer Bureau Section -->
        <div class="hero-transfer-bureau">
          <div class="hero-transfer-bureau-title">譲渡局とは</div>
          <p class="hero-transfer-bureau-text">
            観測された個体の一部は、譲渡局を通じて新たな管理者へ引き継がれる。<br />
            現在譲渡可能な個体や、再観測情報を確認できます。
          </p>
        </div>
        <!-- World Link -->
        <div class="hero-world-link">
          <a href="/about/">この世界について →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ── SECTION_00 鋸歯生物 譲渡局 ────────────────────────── -->
  <section class="transfer-sec">
    <div class="sec-hd reveal">
      <div>
        <div class="sec-no">SECTION_00</div>
