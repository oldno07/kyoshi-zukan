---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const all = await getCollection('creatures');
const published = all
  .filter(e => e.data.status === 'published' && e.data.category === 'creature')
  .sort((a, b) => a.data.no.localeCompare(b.data.no));

const total = 25; // 総登録数（要件書 4章 発見数カウンター）
const found = published.length;

function toSlug(id: string) {
  return id.replace(/\/index\.md$/, '').replace(/\.md$/, '');
}
---

<BaseLayout
  title="鋸歯生物図鑑 — SAWTOOTH CREATURE OBSERVATION DATABASE"
  description="PELICAN WORKS / AGAVEST が観測・記録する鋸歯生物の図鑑データベース。現在 {found} 体の観測記録を公開中。"
>

  <!-- ヒーローヘッダー -->
  <section class="idx-hero">
    <div class="idx-hero-inner">
      <p class="idx-sys">OBSERVATION DATABASE / FIELD CLASSIFICATION</p>
      <h1 class="idx-title">鋸歯生物図鑑</h1>
      <p class="idx-subtitle">SAWTOOTH CREATURE DATABASE</p>
      <div class="idx-count">
        <span class="idx-count-num">{found}</span>
        <span class="idx-count-sep">/</span>
        <span class="idx-count-total">{total}</span>
        <span class="idx-count-label">SPECIMENS DOCUMENTED</span>
      </div>
    </div>
  </section>

  <!-- カタロググリッド -->
  <section class="idx-catalog">
    <p class="idx-catalog-label">ALL ENTRIES</p>
    <div class="idx-grid">
      {published.map((entry) => {
        const slug = toSlug(entry.id);
        const { data } = entry;
        return (
          <a href={`/creatures/${slug}/`} class="idx-card">
            <div class="idx-card-img">
              {data.cover
                ? <img src={data.cover} alt={data.name_jp} loading="lazy" />
                : <div class="idx-card-noimg">NO VISUAL DATA</div>
              }
              <span class={`idx-card-rarity ${data.rarity}`}>{data.rarity}</span>
            </div>
            <div class="idx-card-body">
              <span class="idx-card-no">No.{data.no}</span>
              <p class="idx-card-jp">{data.name_jp}</p>
              <p class="idx-card-en">{data.name_en}</p>
              <p class="idx-card-tag">{data.tag}</p>
            </div>
          </a>
        );
      })}
    </div>
  </section>

</BaseLayout>

<style>
/* ── ヒーロー ─────────────────────────────────────────────── */
.idx-hero {
  border-bottom: 1px solid var(--br2);
  padding: 64px 40px 48px;
}
.idx-hero-inner {
  max-width: 800px;
}
.idx-sys {
  font-family: var(--mono);
  font-size: 9px;
  letter-spacing: 0.35em;
  color: var(--ink3);
  margin-bottom: 24px;
}
.idx-title {
  font-family: var(--disp);
  font-size: clamp(28px, 5vw, 48px);
  font-weight: 800;
  color: var(--ink);
  letter-spacing: 0.05em;
  margin-bottom: 6px;
}
.idx-subtitle {
  font-family: var(--mono);
  font-size: 11px;
  letter-spacing: 0.3em;
  color: var(--ink2);
  margin-bottom: 32px;
}
.idx-count {
  display: flex;
  align-items: baseline;
  gap: 6px;
}
.idx-count-num {
  font-family: var(--mono);
  font-size: 36px;
  font-weight: 700;
  color: var(--g);
}
.idx-count-sep {
  font-family: var(--mono);
  font-size: 20px;
  color: var(--ink3);
}
.idx-count-total {
  font-family: var(--mono);
  font-size: 20px;
  color: var(--ink2);
}
.idx-count-label {
  font-family: var(--mono);
  font-size: 9px;
  letter-spacing: 0.25em;
  color: var(--ink3);
  margin-left: 8px;
}

/* ── カタロググリッド ─────────────────────────────────────── */
.idx-catalog {
  padding: 40px;
}
.idx-catalog-label {
  font-family: var(--mono);
  font-size: 9px;
  letter-spacing: 0.35em;
  color: var(--ink3);
  margin-bottom: 24px;
}
.idx-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
  gap: 16px;
}

/* ── カード ───────────────────────────────────────────────── */
.idx-card {
  display: flex;
  flex-direction: column;
  border: 1px solid var(--br2);
  background: var(--bg2);
  text-decoration: none;
  transition: border-color 0.2s, transform 0.15s;
}
.idx-card:hover {
  border-color: var(--g);
  transform: translateY(-2px);
}
.idx-card-img {
  position: relative;
  aspect-ratio: 1;
  overflow: hidden;
  background: var(--bg);
}
.idx-card-img img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  filter: grayscale(15%);
  transition: filter 0.2s;
}
.idx-card:hover .idx-card-img img {
  filter: grayscale(0%);
}
.idx-card-noimg {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--mono);
  font-size: 7px;
  letter-spacing: 0.15em;
  color: var(--ink3);
}
.idx-card-rarity {
  position: absolute;
  top: 6px;
  right: 6px;
  font-family: var(--mono);
  font-size: 7px;
  letter-spacing: 0.15em;
  font-weight: 700;
  padding: 2px 6px;
  background: rgba(0,0,0,0.6);
}
.idx-card-rarity.LEGEND   { color: #f59e0b; }
.idx-card-rarity.EPIC     { color: #a855f7; }
.idx-card-rarity.RARE     { color: #3b82f6; }
.idx-card-rarity.UNCOMMON { color: #10b981; }
.idx-card-rarity.COMMON   { color: #9ca3af; }

.idx-card-body {
  padding: 12px 14px;
  display: flex;
  flex-direction: column;
  gap: 2px;
}
.idx-card-no {
  font-family: var(--mono);
  font-size: 8px;
  letter-spacing: 0.2em;
  color: var(--ink3);
}
.idx-card-jp {
  font-family: var(--disp);
  font-size: 12px;
  color: var(--ink);
  margin-top: 3px;
  line-height: 1.3;
}
.idx-card-en {
  font-family: var(--mono);
  font-size: 8px;
  letter-spacing: 0.08em;
  color: var(--ink2);
  line-height: 1.4;
}
.idx-card-tag {
  font-family: var(--mono);
  font-size: 7px;
  letter-spacing: 0.1em;
  color: var(--ink3);
  margin-top: 4px;
  border-top: 1px solid var(--br2);
  padding-top: 6px;
}

/* ── モバイル ─────────────────────────────────────────────── */
@media (max-width: 640px) {
  .idx-hero { padding: 40px 24px 32px; }
  .idx-catalog { padding: 32px 24px; }
  .idx-grid { grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: 12px; }
}
</style>
