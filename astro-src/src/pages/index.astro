---
import '../styles/global.css';
---

<!doctype html>
<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>PelicanWorks</title>
  <meta name="description" content="棚を見守る生き物が、そこにいます。" />
  <link rel="canonical" href="https://pelicanworks.site/" />

  <meta property="og:type" content="website" />
  <meta property="og:title" content="PelicanWorks" />
  <meta property="og:description" content="棚を見守る生き物が、そこにいます。" />
  <meta property="og:url" content="https://pelicanworks.site/" />
  <meta property="og:site_name" content="PelicanWorks" />
  <meta name="twitter:card" content="summary" />

  <link rel="stylesheet" href="/css/style.css" />

  <!-- GA4 (9-4: G-9MRML3BZ6M 正式採用) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-9MRML3BZ6M"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-9MRML3BZ6M');
  </script>
</head>
<body class="hub-body">
  <main class="hub-main">
    <div class="hub-inner">
      <h1 class="hub-brand">PelicanWorks</h1>
      <p class="hub-tagline">棚を見守る生き物が、そこにいます。</p>

      <div class="hub-cards">
        <article class="hub-card">
          <div class="hub-card-photo">
            <img
              src="/images/hub-agave-cat.jpg"
              alt="鉢の縁にぶら下がる鋸歯生物と斑入りアガベ"
              width="640"
              height="800"
              loading="eager"
            />
          </div>
          <h2 class="hub-card-title">鋸歯生物</h2>
          <p class="hub-card-desc">アガベ・塊根植物の棚に棲む、住人たちの記録。</p>
          <div class="hub-card-links">
            <a href="/zukan/" class="hub-card-link">図鑑を見る →</a>
            <a href="/labo" class="hub-card-link">研究所を覗く →</a>
            <a
              href="https://agavest.stores.jp/"
              target="_blank"
              rel="noopener noreferrer"
              class="hub-card-link"
            >譲渡局へ →</a>
          </div>
        </article>
      </div>
    </div>
  </main>

  <footer class="hub-footer">
    <a
      href="https://www.instagram.com/pelican.works"
      target="_blank"
      rel="noopener noreferrer"
      class="hub-footer-link"
    >Instagram: @pelican.works</a>
  </footer>

  <style>
    .hub-body {
      padding-top: 0;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }
    .hub-main {
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 40px;
    }
    .hub-inner {
      max-width: 640px;
      width: 100%;
    }
    .hub-brand {
      font-family: var(--disp);
      font-size: clamp(32px, 6vw, 48px);
      font-weight: 800;
      letter-spacing: 0.02em;
      color: var(--ink);
      margin-bottom: 16px;
    }
    .hub-tagline {
      font-size: 14px;
      line-height: 1.9;
      color: var(--ink2);
      margin-bottom: 48px;
    }
    .hub-cards {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: 20px;
    }
    .hub-card {
      border: 1px solid var(--br2);
      background: var(--bg2);
      padding: 28px;
    }
    .hub-card-photo {
      border-radius: 18px;
      overflow: hidden;
      aspect-ratio: 4 / 5;
      margin-bottom: 24px;
      background: var(--bg3);
    }
    .hub-card-photo img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .hub-card-title {
      font-family: var(--disp);
      font-size: 20px;
      font-weight: 700;
      color: var(--ink);
      margin-bottom: 8px;
    }
    .hub-card-desc {
      font-family: var(--sans);
      font-size: 13px;
      line-height: 1.8;
      color: var(--ink2);
      margin-bottom: 24px;
    }
    .hub-card-links {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }
    .hub-card-link {
      font-family: var(--sans);
      font-size: 14px;
      color: var(--g);
      text-decoration: none;
      transition: opacity 0.2s;
    }
    .hub-card-link:hover { opacity: 0.6; }
    .hub-footer {
      padding: 24px 40px;
      border-top: 1px solid var(--br2);
      text-align: center;
    }
    .hub-footer-link {
      font-family: var(--mono);
      font-size: 11px;
      letter-spacing: 0.1em;
      color: var(--ink3);
      text-decoration: none;
      transition: color 0.2s;
    }
    .hub-footer-link:hover { color: var(--g); }

    @media (max-width: 640px) {
      .hub-main { padding: 24px; }
      .hub-footer { padding: 20px 24px; }
    }
  </style>
</body>
</html>
