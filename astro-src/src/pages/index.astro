---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const all = await getCollection('creatures');

// category: creature のみ（symbiont はカウント・表示ともに除外）
const allCreatures = all
  .filter(e => e.data.category === 'creature')
  .sort((a, b) => a.data.no.localeCompare(b.data.no));

// 発見数は published のみカウント（要件書4章：hidden は含めない）
const published = allCreatures.filter(e => e.data.status === 'published');
const TOTAL = 25;
const found = published.length;

// 注目標本（featured: true かつ published）
const featured = published.filter(e => e.data.featured);

// 共生生物（category: symbiont）
const symbionts = all
  .filter(e => e.data.category === 'symbiont')
  .sort((a, b) => a.data.no.localeCompare(b.data.no));

// フィルター用：published の全タグ・シリーズ・レアリティを収集
const allTags    = [...new Set(published.flatMap(e => e.data.tags))].sort();
const allSeries  = [...new Set(published.flatMap(e => e.data.series))].filter(Boolean).sort();
const RARITY_ORDER = ['LEGEND','EPIC','RARE','UNCOMMON','COMMON'] as const;
const allRarities = RARITY_ORDER.filter(r => published.some(e => e.data.rarity === r));

function toSlug(id: string) {
  return id.replace(/\/index\.md$/, '').replace(/\.md$/, '');
}

const progressPct = Math.round((found / TOTAL) * 100);
---

<BaseLayout
  title="鋸歯生物図鑑 — SAWTOOTH CREATURE OBSERVATION DATABASE"
  description={`PELICAN WORKS / AGAVEST が観測・記録する鋸歯生物の図鑑データベース。現在 ${found} 体の観測記録を公開中。`}
>
  <!-- style.css を head に注入（既存CSSをそのまま使用） -->
  <link slot="head" rel="stylesheet" href="/css/style.css" />

  <!-- ── ヒーロー（本番index.html と同一構成・文言・クラス名） ── -->
  <section class="hero-archive">
    <!-- Layer 1: Video Background -->
    <div class="hero-video-layer">
      <video class="hero-video hero-video-main" autoplay muted loop playsinline>
        <source src="/images/hero-video.mp4" type="video/mp4" />
      </video>
    </div>
    <!-- Layer 2: Darkening & Saturation Overlay -->
    <div class="hero-darken-overlay"></div>
    <!-- Layer 3: Noise Overlay -->
    <div class="hero-noise-overlay"></div>
    <!-- Layer 4: Glass Blur Overlay -->
    <div class="hero-glass-overlay"></div>
    <!-- Layer 5: Text Content -->
    <div class="hero-content-layer">
      <div class="hero-archive-container">
        <!-- Main Title -->
        <div class="hero-title-group">
          <h1 class="hero-main-title">
