---
import '../styles/global.css';

/*
 * カード画像の入れ方
 *   1. 画像ファイルを astro-src/public/images/ に置く（実体。シンボリックリンク不可）
 *   2. 下の image に "/images/ファイル名" を書く。public/ から先のパスを / 始まりで書く
 *   3. image が null の間は罫線のみのプレースホルダーが表示される
 * 推奨仕様：縦長 4:5、600×750px 程度、jpg。表示は最大136px幅なので2倍解像度で十分
 */
const channels = [
  {
    tab: 'コンセプト',
    title: '鋸歯生物研究所',
    desc: '鋸歯生物がどんな作品なのか、写真でご紹介します。',
    label: '研究所を見る',
    href: '/labo',
    external: false,
    image: '/images/hub-labo.jpg',
    alt: '鉢の縁から顔をのぞかせる赤い鋸歯生物',
  },
  {
    tab: '作品一覧',
    title: '鋸歯生物図鑑',
    desc: 'これまでに作った鋸歯生物を、一体ずつ掲載しています。',
    label: '図鑑を見る',
    href: '/zukan/',
    external: false,
    image: '/images/hub-zukan.jpg',
    alt: 'アガベの鉢の縁にぶら下がる鋸歯生物',
  },
  {
    tab: 'オンラインショップ',
    title: '鋸歯生物譲渡局',
    desc: '作品の販売はこちらから。入荷は不定期です。',
    label: '譲渡局へ',
    href: 'https://agavest.stores.jp/',
    external: true,
    image: '/images/hub-store.jpg',
    alt: 'コルク台に並ぶ複数の鋸歯生物',
  },
];
---

<!doctype html>
<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>PelicanWorks</title>
  <meta name="description" content="植物棚に置く生き物を、樹脂粘土で作っています。" />
  <link rel="canonical" href="https://pelicanworks.site/" />

  <meta property="og:type" content="website" />
  <meta property="og:title" content="PelicanWorks" />
  <meta property="og:description" content="植物棚に置く生き物を、樹脂粘土で作っています。" />
  <meta property="og:url" content="https://pelicanworks.site/" />
  <meta property="og:site_name" content="PelicanWorks" />
  <meta name="twitter:card" content="summary" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=BIZ+UDMincho:wght@400;700&family=Zen+Old+Mincho:wght@400;500;600&family=Zen+Kaku+Gothic+New:wght@300;400;500&display=swap"
    rel="stylesheet"
  />

  <!-- GA4 (9-4: G-9MRML3BZ6M 正式採用)。本番ホストのみ読み込む（開発・プレビューデプロイでの計測混入を防止） -->
  <script is:inline>
    (function () {
      var ALLOWED = [
        'pelicanworks.site',
        'www.pelicanworks.site',
        'kyoshi-zukan.pages.dev'
      ];
      if (ALLOWED.indexOf(location.hostname) === -1) return;

      var s = document.createElement('script');
      s.async = true;
      s.src = 'https://www.googletagmanager.com/gtag/js?id=G-9MRML3BZ6M';
      document.head.appendChild(s);

      window.dataLayer = window.dataLayer || [];
      function gtag(){ window.dataLayer.push(arguments); }
      window.gtag = gtag;
      gtag('js', new Date());
      gtag('config', 'G-9MRML3BZ6M');
    })();
  </script>
</head>
<body class="hub-body">
  <main class="hub-main">
    <div class="hub-inner">
      <header class="hub-head">
        <h1 class="hub-brand">PelicanWorks</h1>
        <div class="hub-tagline-wrap">
          <p class="hub-tagline">植物棚に置く生き物を、<br />樹脂粘土で作っています。</p>
        </div>
      </header>

      <div class="hub-cards">
        {channels.map((ch) => (
          <article class="hub-card">
            <div class="hub-card-photo">
              {ch.image && (
                <img src={ch.image} alt={ch.alt} width="600" height="750" loading="lazy" />
              )}
            </div>
            <div class="hub-card-body">
              <span class="hub-card-tab">{ch.tab}</span>
              <h2 class="hub-card-title">{ch.title}</h2>
              <p class="hub-card-desc">{ch.desc}</p>
              <a
                href={ch.href}
                class="hub-card-btn"
                target={ch.external ? '_blank' : undefined}
                rel={ch.external ? 'noopener noreferrer' : undefined}
              >
                <span class="hub-card-btn-label">{ch.label}</span>
                <svg
                  class="hub-card-btn-icon"
                  width="14"
                  height="14"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <line x1="7" y1="17" x2="17" y2="7" />
                  <polyline points="7 7 17 7 17 17" />
                </svg>
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </main>

  <footer class="hub-footer">
    <a
      href="https://www.instagram.com/pelican.works"
      target="_blank"
      rel="noopener noreferrer"
      class="hub-footer-link"
    >Instagram: @pelican.works</a>
  </footer>

  <style>
    /* ハブページ専用トークン（アクセントは掲載写真から抽出したアガベグリーン中間トーン） */
    .hub-body {
      --hub-bg:     #fafaf8;
      --hub-ink:    #1a1a1a;
      --hub-ink2:   #3c3c38;
      --hub-line:   #e2e2db;
      --hub-pill:   #f0f0ea;
      --hub-accent: #616731;
      --hub-accent-deep: #4d5327;
      /* Webフォント未読込時も縦書きメトリクスが崩れないよう和文システムフォントまで指定 */
      --hub-mincho: "Zen Old Mincho", "Shippori Mincho", "Hiragino Mincho ProN", "Yu Mincho", serif;
      /* キャッチ専用：UD系明朝。Windowsは同名フォントを標準搭載しているため次点に置く */
      --hub-catch:  "BIZ UDMincho", "BIZ UDPMincho", "Hiragino Mincho ProN", "Yu Mincho", serif;
      --hub-gothic: "Zen Kaku Gothic New", "Noto Sans JP", "Hiragino Kaku Gothic ProN", "Yu Gothic", Meiryo, sans-serif;

      padding-top: 0;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      background: var(--hub-bg);
      color: var(--hub-ink);
      font-family: var(--hub-gothic);
    }

    .hub-main {
      flex: 1;
      display: flex;
      justify-content: center;
      padding: 88px 24px 96px;
    }
    .hub-inner {
      width: 100%;
      max-width: 680px;
    }

    /* -- 第1層：ブランド名＋縦書きタグライン -- */
    .hub-head {
      text-align: center;
    }
    .hub-brand {
      font-family: var(--hub-mincho);
      font-size: clamp(32px, 6.4vw, 46px);
      font-weight: 500;
      letter-spacing: 0.12em;
      line-height: 1.3;
      color: var(--hub-ink);
    }
    /* キャッチの上下に余白を確保。下をやや広く取り、続くカード群との視覚的な重心を揃える */
    .hub-tagline-wrap {
      display: flex;
      justify-content: center;
      padding: 84px 0 104px;
    }
    .hub-tagline {
      writing-mode: vertical-rl;
      font-family: var(--hub-catch);
      font-size: 20px;
      font-weight: 400;
      line-height: 2.4;
      letter-spacing: 0.18em;
      color: var(--hub-ink2);
    }

    /* -- 第2層：3チャンネルカード（画像左・内容右の横並び、同一フォーマット） -- */
    .hub-card {
      display: grid;
      grid-template-columns: 136px 1fr;
      gap: 24px;
      align-items: start;
      padding: 32px 0;
    }
    .hub-card:first-child { padding-top: 0; }
    .hub-card:last-child { padding-bottom: 0; }
    .hub-card + .hub-card { border-top: 1px dashed var(--hub-line); }

    .hub-card-photo {
      aspect-ratio: 4 / 5;
      border: 1px solid var(--hub-line);
      border-radius: 4px;
      overflow: hidden;
    }
    .hub-card-photo img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .hub-card-body {
      min-width: 0;
    }
    /* ピルのみグレー地を許可（他要素の背景塗りは引き続き禁止） */
    .hub-card-tab {
      display: inline-block;
      background: var(--hub-pill);
      border-radius: 999px;
      padding: 6px 15px;
      font-family: var(--hub-gothic);
      font-size: 12px;
      font-weight: 400;
      letter-spacing: 0.1em;
      line-height: 1.5;
      color: var(--hub-ink2);
      margin-bottom: 16px;
    }
    .hub-card-title {
      font-family: var(--hub-mincho);
      font-size: 21px;
      font-weight: 500;
      letter-spacing: 0.1em;
      line-height: 1.5;
      color: var(--hub-ink);
      margin-bottom: 10px;
    }
    .hub-card-desc {
      font-family: var(--hub-gothic);
      font-size: 14px;
      font-weight: 300;
      line-height: 1.95;
      letter-spacing: 0.04em;
      color: var(--hub-ink2);
      margin-bottom: 20px;
    }
    .hub-card-btn {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      padding: 13px 18px;
      border: 1px solid var(--hub-line);
      border-radius: 4px;
      font-family: var(--hub-gothic);
      font-size: 14px;
      font-weight: 400;
      letter-spacing: 0.08em;
      color: var(--hub-accent);
      text-decoration: none;
      transition: border-color 0.2s, color 0.2s;
    }
    .hub-card-btn:hover {
      border-color: var(--hub-accent);
      color: var(--hub-accent-deep);
    }
    .hub-card-btn-icon { flex-shrink: 0; }

    /* -- フッター -- */
    .hub-footer {
      border-top: 1px solid var(--hub-line);
      padding: 26px 24px;
      text-align: center;
    }
    .hub-footer-link {
      font-family: var(--hub-gothic);
      font-size: 13px;
      font-weight: 400;
      letter-spacing: 0.1em;
      color: var(--hub-ink2);
      text-decoration: none;
      transition: color 0.2s;
    }
    .hub-footer-link:hover { color: var(--hub-accent); }

    @media (max-width: 640px) {
      .hub-main { padding: 64px 20px 72px; }
      .hub-tagline-wrap { padding: 60px 0 76px; }
      /* 右カラムの行間・余白を詰め、サムネイルを拡大して画像下の空きを抑える */
      .hub-tagline { font-size: 17px; }
      .hub-card {
        grid-template-columns: 116px 1fr;
        gap: 14px;
        padding: 26px 0;
      }
      .hub-card-tab {
        font-size: 11.5px;
        padding: 5px 13px;
        margin-bottom: 10px;
      }
      .hub-card-title {
        font-size: 19px;
        line-height: 1.4;
        margin-bottom: 6px;
      }
      .hub-card-desc {
        font-size: 13.5px;
        line-height: 1.75;
        margin-bottom: 14px;
      }
      .hub-card-btn {
        padding: 11px 15px;
        font-size: 13.5px;
      }
    }
  </style>
</body>
</html>
