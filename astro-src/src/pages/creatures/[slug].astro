---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const all = await getCollection('creatures', ({ data }) => data.status === 'published');
  // no 番号順でソート
  const sorted = all.sort((a, b) => a.data.no.localeCompare(b.data.no));

  function toSlug(id: string) {
    return id.replace(/\/index\.md$/, '').replace(/\.md$/, '');
  }

  return sorted.map((entry, index) => {
    const slug = toSlug(entry.id);
    const prevEntry = index > 0 ? sorted[index - 1] : null;
    const nextEntry = index < sorted.length - 1 ? sorted[index + 1] : null;

    return {
      params: { slug },
      props: {
        entry,
        prev: prevEntry
          ? { slug: toSlug(prevEntry.id), name_jp: prevEntry.data.name_jp, name_en: prevEntry.data.name_en }
          : null,
        next: nextEntry
          ? { slug: toSlug(nextEntry.id), name_jp: nextEntry.data.name_jp, name_en: nextEntry.data.name_en }
          : null,
      },
    };
  });
}

const { entry, prev, next } = Astro.props;
const { slug } = Astro.params;
const { data } = entry;
const { Content } = await render(entry);

const ogTitle = `${data.name_jp} / ${data.name_en} | 鋸歯生物図鑑`;
const ogDescription = data.notes
  ? data.notes.slice(0, 100) + (data.notes.length > 100 ? '…' : '')
  : `No.${data.no} ${data.name_jp} — 鋸歯生物観測記録`;
---

<BaseLayout
  title={ogTitle}
  description={ogDescription}
  ogImage={data.cover}
  ogUrl={`https://kyoshi-zukan.pages.dev/creatures/${slug}/`}
>
  <!-- breadcrumb strip -->
  <nav class="cd-strip">
    <a href="/" class="cd-strip-back">← FIELD DATABASE</a>
    <div class="cd-strip-path">
      <span>CREATURES</span>
      <span class="cd-strip-sep">/</span>
      <span class="cd-strip-id">No.{data.no}</span>
    </div>
  </nav>

  <!-- hero -->
  <section class="cd-hero">
    <div class="cd-hero-l">
      <div class="cd-hero-meta">
        <span class="cd-no">No.{data.no}</span>
        <span class={`cd-rarity ${data.rarity}`}>{data.rarity}</span>
        <span class="cd-tag">{data.tag}</span>
      </div>
      <h1 class="cd-name-jp">{data.name_jp}</h1>
      <p class="cd-name-en">{data.name_en}</p>

      {data.status_label && (
        <span
          class="cd-status-badge"
          style={`color: ${data.status_color ?? 'var(--g)'}`}
        >
          ● {data.status_label}
        </span>
      )}
    </div>

    <div class="cd-hero-r">
      {data.cover
        ? <img src={data.cover} alt={data.name_jp} class="cd-cover" loading="eager" />
        : <div class="cd-no-visual">NO VISUAL DATA</div>
      }
    </div>
  </section>

  <!-- status bars（数値系のみ。HABITAT/TYPE はここに置かない） -->
  <section class="cd-status">
    <p class="cd-status-title">BIOLOGICAL STATUS</p>
    <div class="cd-bars">
      <div class="cd-bar-row">
        <span class="cd-bar-label">PLANT</span>
        <div class="cd-bar-track">
          <div class="cd-bar-fill plant" style={`width: ${data.plant}%`}></div>
        </div>
        <span class="cd-bar-val">{data.plant}</span>
      </div>
      <div class="cd-bar-row">
        <span class="cd-bar-label">ANIMAL</span>
        <div class="cd-bar-track">
          <div class="cd-bar-fill animal" style={`width: ${data.animal}%`}></div>
        </div>
        <span class="cd-bar-val">{data.animal}</span>
      </div>
      <div class="cd-bar-row">
        <span class="cd-bar-label">DANGER</span>
        <div class="cd-bar-track">
          <div class="cd-bar-fill danger" style={`width: ${data.danger}%`}></div>
        </div>
        <span class="cd-bar-val">{data.danger}</span>
      </div>
    </div>
  </section>

  <!-- body -->
  <article class="cd-body">

    <div class="cd-body-text">
      <Content />
    </div>

    {data.notes && (
      <div class="cd-note">
        <p class="cd-note-label">
          RESEARCH NOTE{data.namer ? ` — ${data.namer}` : ''}
        </p>
        <p class="cd-note-text">{data.notes}</p>
      </div>
    )}

    {data.abilities.length > 0 && (
      <div style="margin-bottom: 32px;">
        <p class="cd-status-title" style="margin-bottom: 12px;">ABILITIES</p>
        <div class="cd-abilities">
          {data.abilities.map((a) => (
            <span class="cd-ability">{a}</span>
          ))}
        </div>
      </div>
    )}

    <!-- フィールドデータ（各値は1箇所のみ） -->
    <div class="cd-data">
      <div class="cd-data-row">
        <span class="cd-data-key">HABITAT</span>
        <span class="cd-data-val">{data.habitat}</span>
      </div>
      <div class="cd-data-row">
        <span class="cd-data-key">SIZE</span>
        <span class="cd-data-val">{data.size}</span>
      </div>
      <div class="cd-data-row">
        <span class="cd-data-key">MOBILITY</span>
        <span class="cd-data-val">{data.mobility}</span>
      </div>
      {data.top && (
        <div class="cd-data-row">
          <span class="cd-data-key">BASED ON</span>
          <span class="cd-data-val">{data.top}</span>
        </div>
      )}
    </div>

    {data.shopUrl && !data.soldOut && (
      <a href={data.shopUrl} class="cd-shop" target="_blank" rel="noopener">
        → ACQUISITION REQUEST
      </a>
    )}
    {data.soldOut && (
      <p style="font-family:var(--mono);font-size:11px;letter-spacing:0.2em;color:var(--ink3);margin-bottom:40px;">
        SOLD OUT
      </p>
    )}

  </article>

  <!-- gallery -->
  {data.gallery.length > 0 && data.gallery.some(g => g.path) && (
    <section class="cd-gallery">
      <p class="cd-gallery-title">OBSERVATION GALLERY</p>
      <div class="cd-gallery-grid">
        {data.gallery.filter(g => g.path).map((g) => (
          <div class="cd-gallery-item">
            <img src={g.path} alt={g.title ?? ''} loading="lazy" />
            {(g.title || g.desc) && (
              <div class="cd-gallery-cap">
                {g.title && <p class="cd-gallery-cap-title">{g.title}</p>}
                {g.desc  && <p class="cd-gallery-cap-desc">{g.desc}</p>}
              </div>
            )}
          </div>
        ))}
      </div>
    </section>
  )}

  <!-- videos -->
  {data.videos.length > 0 && (
    <section class="cd-videos">
      <p class="cd-videos-title">OBSERVATION RECORDS</p>
      <div class="cd-video-list">
        {data.videos.map((v) => (
          <div>
            {v.title && <p class="cd-video-label">{v.observedAt ? `[${v.observedAt}] ` : ''}{v.title}</p>}
            <div class="cd-video-embed">
              <iframe
                src={`https://www.youtube.com/embed/${v.youtubeId}`}
                title={v.title ?? '観測動画'}
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen
                loading="lazy"
              ></iframe>
            </div>
          </div>
        ))}
      </div>
    </section>
  )}

  <!-- ===== PREV / NEXT NAV ===== -->
  <nav class="cd-prevnext">
    {prev
      ? (
        <a href={`/creatures/${prev.slug}/`} class="cd-prevnext-btn">
          <span class="cd-prevnext-dir">← PREV</span>
          <span class="cd-prevnext-jp">{prev.name_jp}</span>
          <span class="cd-prevnext-en">{prev.name_en}</span>
        </a>
      )
      : <span class="cd-prevnext-btn cd-prevnext-empty">— FIRST ENTRY —</span>
    }
    {next
      ? (
        <a href={`/creatures/${next.slug}/`} class="cd-prevnext-btn cd-prevnext-right">
          <span class="cd-prevnext-dir">NEXT →</span>
          <span class="cd-prevnext-jp">{next.name_jp}</span>
          <span class="cd-prevnext-en">{next.name_en}</span>
        </a>
      )
      : <span class="cd-prevnext-btn cd-prevnext-right cd-prevnext-empty">— LAST ENTRY —</span>
    }
  </nav>

  <!-- sys divider -->
  <div class="cd-sys">
    <div class="cd-sys-line"></div>
    <span class="cd-sys-label">END OF RECORD — No.{data.no}</span>
    <div class="cd-sys-line"></div>
  </div>

  <!-- ===== MOBILE FIXED FOOTER BAR ===== -->
  <div class="mobile-fixed-footer" id="mobile-fixed-footer">
    {prev
      ? (
        <a href={`/creatures/${prev.slug}/`} class="mobile-footer-link">
          <span class="mobile-footer-icon">◈</span>
          <span class="mobile-footer-text">前の個体</span>
        </a>
      )
      : <span class="mobile-footer-link mobile-footer-disabled">
          <span class="mobile-footer-icon">◈</span>
          <span class="mobile-footer-text">前の個体</span>
        </span>
    }
    <a href="/" class="mobile-footer-link">
      <span class="mobile-footer-icon">◈</span>
      <span class="mobile-footer-text">一覧へ戻る</span>
    </a>
    {next
      ? (
        <a href={`/creatures/${next.slug}/`} class="mobile-footer-link">
          <span class="mobile-footer-icon">◈</span>
          <span class="mobile-footer-text">次の個体</span>
        </a>
      )
      : <span class="mobile-footer-link mobile-footer-disabled">
          <span class="mobile-footer-icon">◈</span>
          <span class="mobile-footer-text">次の個体</span>
        </span>
    }
  </div>

  <!-- モバイル固定バーのスクロール制御 -->
  <script>
    const bar = document.getElementById('mobile-fixed-footer');
    if (bar) {
      let lastY = 0;
      window.addEventListener('scroll', () => {
        const y = window.scrollY;
        // 下スクロール時に非表示、上スクロール or トップ付近で表示
        if (y > lastY && y > 80) {
          bar.classList.remove('visible');
        } else {
          bar.classList.add('visible');
        }
        lastY = y;
      }, { passive: true });
      // 初期表示
      bar.classList.add('visible');
    }
  </script>

</BaseLayout>
