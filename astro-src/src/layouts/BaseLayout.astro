---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogUrl?: string;
}

const { title, description = '鋸歯生物図鑑 — SAWTOOTH CREATURE OBSERVATION DATABASE', ogImage, ogUrl } = Astro.props;
const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? '';
const canonicalUrl = ogUrl ?? (siteUrl + Astro.url.pathname);
const ogImageAbsolute = ogImage ? (ogImage.startsWith('http') ? ogImage : siteUrl + ogImage) : undefined;
---

<!doctype html>
<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />

  <!-- OGP -->
  <meta property="og:type" content="article" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalUrl} />
  {ogImageAbsolute && <meta property="og:image" content={ogImageAbsolute} />}
  <meta property="og:site_name" content="鋸歯生物図鑑" />
  <meta name="twitter:card" content="summary_large_image" />
  <slot name="head" />

  <!-- GA4 (9-4: G-9MRML3BZ6M 正式採用) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-9MRML3BZ6M"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-9MRML3BZ6M');
  </script>
</head>
<body>
  <Header />
  <main>
    <slot />
  </main>
  <Footer />

  <!-- SYSTEM CONNECTION OVERLAY（モバイルフッターリンクのページ遷移演出） -->
  <div class="system-connection-overlay" id="system-connection-overlay">
    <div class="system-connection-content">
      <div class="system-connection-noise"></div>
      <div class="system-connection-scanline"></div>
      <div class="system-connection-text" id="system-connection-text">CONNECTING...</div>
      <div class="system-connection-status" id="system-connection-status"></div>
    </div>
  </div>

  <script>
    function initSystemConnectionLinks() {
      const systemLinks = document.querySelectorAll('.mobile-footer-link');
      const overlay = document.getElementById('system-connection-overlay');
      const textEl = document.getElementById('system-connection-text');
      const statusEl = document.getElementById('system-connection-status');

      if (!systemLinks.length || !overlay || !textEl || !statusEl) return;

      systemLinks.forEach((link) => {
        link.addEventListener('click', (e) => {
          const href = link.getAttribute('href');
          if (!href || href === '#') return;

          e.preventDefault();
          const isExternal = link.getAttribute('target') === '_blank';

          const messages = ['CONNECTING...', 'OBSERVATION NODE ACTIVE'];
          textEl.textContent = messages[Math.floor(Math.random() * messages.length)];
          overlay.classList.add('active');

          const delay = 400 + Math.random() * 200;

          setTimeout(() => {
            statusEl.textContent = 'SIGNAL CONFIRMED';
            statusEl.classList.add('visible');
          }, delay - 100);

          setTimeout(() => {
            if (isExternal) {
              window.open(href, '_blank');
            } else {
              window.location.href = href;
            }
            setTimeout(() => {
              overlay.classList.remove('active');
              statusEl.classList.remove('visible');
            }, 100);
          }, delay);
        });
      });
    }

    initSystemConnectionLinks();
  </script>
</body>
</html>
